function LegacyUI:Notify(options)
    options = type(options) == "table" and options or { Content = tostring(options or "") }
    local title = tostring(options.Title or "OnrushaHub")
    local kind = tostring(options.Type or (title == "Error" and "Error" or title == "Success" and "Success" or "Info"))
    if ui then
        ui:Notify({
            Title = title,
            Description = tostring(options.Content or options.Description or ""),
            Duration = tonumber(options.Duration) or 4,
            Type = kind,
        })
    else
        warn("[OnrushaHub] " .. title .. ": " .. tostring(options.Content or options.Description or ""))
    end
end

