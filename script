    local windowFacade = {}
    function windowFacade:CreateTab(name, icon)
        name = tostring(name or "Tab")
        local tab = ui:TabCreate({
            Name = name,
            Icon = string.sub(name, 1, 1),
            Description = name .. " controls",
        })
        local tabFacade = {
            _tab = tab,
            _sideCursor = 0,
            _sections = {},
            _currentSection = nil,
        }
        function tabFacade:_createSection(sectionName, side)
            self._sideCursor += 1
            local useSide = side or (self._sideCursor % 2 == 1 and "Left" or "Right")
            local section = self._tab:SectionCreate({
                Name = tostring(sectionName or "Controls"),
                Side = useSide,
            })
            table.insert(self._sections, section)
            self._currentSection = section
            return section
        end
        function tabFacade:_nextSection()
            if not self._currentSection then
                return self:_createSection("Controls")
            end
            return self._currentSection
        end
        function tabFacade:CreateSection(sectionName, side)
            return self:_createSection(sectionName or "Controls", side)
        end
        function tabFacade:CreateParagraph(options2)
            options2 = type(options2) == "table" and options2 or { Content = tostring(options2 or "") }
            local section = self:_nextSection()
            return section:ParagraphCreate({
                Id = tostring(math.random(1, 999999)),
                Name = tostring(options2.Title or "Information"),
                Text = tostring(options2.Content or ""),
            })
        end
        function tabFacade:CreateButton(options2)
            options2 = type(options2) == "table" and options2 or { Name = tostring(options2 or "Button") }
            local name2 = tostring(options2.Name or "Button")
            local section = self:_nextSection()
            local component = section:ButtonCreate({
                Id = tostring(math.random(1, 999999)),
                Name = name2,
                Description = options2.Description or "",
                ButtonText = options2.ButtonText or name2,
            })
            if type(options2.Callback) == "function" then
                component:OnClick(options2.Callback)
            end
            return component
        end
        function tabFacade:CreateToggle(options2)
            options2 = type(options2) == "table" and options2 or { Name = tostring(options2 or "Toggle") }
            local name2 = tostring(options2.Name or "Toggle")
            local section = self:_nextSection()
            local component = section:ToggleCreate({
                Id = tostring(math.random(1, 999999)),
                Name = name2,
                Description = options2.Description or "",
                Default = options2.CurrentValue == true,
            })
            if type(options2.Callback) == "function" then
                component:OnChanged(options2.Callback)
            end
            return component
        end
        function tabFacade:CreateSlider(options2)
            options2 = type(options2) == "table" and options2 or { Name = tostring(options2 or "Slider") }
            local name2 = tostring(options2.Name or "Slider")
            local range = type(options2.Range) == "table" and options2.Range or { 0, 100 }
            local minValue = tonumber(range[1]) or 0
            local maxValue = tonumber(range[2]) or 100
            local step = tonumber(options2.Increment) or 1
            if step <= 0 then step = 1 end
            local defaultValue = tonumber(options2.CurrentValue) or minValue
            local section = self:_nextSection()
            local component = section:SliderCreate({
                Id = tostring(math.random(1, 999999)),
                Name = name2,
                Description = options2.Description or "",
                Min = minValue,
                Max = maxValue,
                Step = step,
                Default = defaultValue,
                Suffix = tostring(options2.Suffix or ""),
            })
            if type(options2.Callback) == "function" then
                component:OnChanged(options2.Callback)
            end
            return component
        end
        return tabFacade
    end
    return windowFacade
end

